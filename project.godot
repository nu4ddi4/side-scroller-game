; Godot 4.6 project. Open with Godot 4.6.3 or later in the 4.6 series.
config_version=5

[application]
config/name="한 번만 더!"
config/description="쉬운 조작, 악랄한 함정, 빠른 재도전. ONE MORE TRY!"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.2.0"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.69, 0.84, 0.86, 1)
textures/vram_compression/import_etc2_astc=false

[physics]
common/physics_ticks_per_second=120
2d/default_gravity=1300.0

[audio]
driver/enable_input=false
